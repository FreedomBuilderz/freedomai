{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": "electron",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["electron/**/*.test.ts", "electron/preload.ts"]
}
